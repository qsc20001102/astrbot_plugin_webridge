+fn inspect_large_jpeg(bytes: &[u8]) -> Result<ImageInspection> {
+    use jpeg_decoder::PixelFormat;
+    ensure!(jpeg_has_end_marker(bytes), "jpeg_trailer_missing");
+    let failure = |_| anyhow::anyhow!("image_decode_failed");
+    let mut decoder = jpeg_decoder::Decoder::new(Cursor::new(bytes));
+    decoder.set_max_decoding_buffer_size(128 * 1024 * 1024);
+    decoder.read_info().map_err(failure)?;
+    let info = decoder
+        .info()
+        .ok_or_else(|| anyhow::anyhow!("image_decode_failed"))?;
+    let (width, height) = (u32::from(info.width), u32::from(info.height));
+    ensure!(
+        width > 0
+            && height > 0
+            && width <= 8192
+            && height <= 8192
+            && u64::from(width) * u64::from(height) <= 64_000_000,
+        "image_decode_limit"
+    );
+    let channels = match info.pixel_format {
+        PixelFormat::L8 => 1,
+        PixelFormat::RGB24 => 3,
+        _ => anyhow::bail!("image_format_unsupported"),
+    };
+    let (scaled_width, scaled_height) = decoder.scale(1280, 1280).map_err(failure)?;
+    let decoded = decoder.decode().map_err(failure)?;
+    ensure!(
+        decoded.len() == usize::from(scaled_width) * usize::from(scaled_height) * channels,
+        "image_decode_failed"
+    );
+    Ok(ImageInspection {
+        content_type: "image/jpeg".into(),
+        width,
+        height,
+        frames: 1,
+        animation_preserved: false,
+    })
