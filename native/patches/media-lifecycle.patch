diff --git a/packages/native-client-rust/crates/wechat-store/src/temporary_media.rs b/packages/native-client-rust/crates/wechat-store/src/temporary_media.rs
new file mode 100644
index 0000000..5d83575
--- /dev/null
+++ b/packages/native-client-rust/crates/wechat-store/src/temporary_media.rs
@@ -0,0 +1,374 @@
+//! Sender-owned staging files. Account/profile caches and original paths are never removed.
+use crate::*;
+use std::io::{Read, Write};
+
+pub const TEMPORARY_MEDIA_MARKER: &[u8] = b"temporary-media-file-v1";
+
+pub fn is_temporary_media_source(id: &str) -> bool {
+    id.starts_with("upload_tmp_")
+}
+
+impl Store {
+    fn temporary_media_path(&self, account: &str, id: &str) -> Result<PathBuf> {
+        if !is_temporary_media_source(id)
+            || id.len() > 100
+            || !id
+                .bytes()
+                .all(|b| b.is_ascii_alphanumeric() || b == b'_' || b == b'-')
+        {
+            bail!("invalid temporary media identity");
+        }
+        let directory = self.account_dir(account)?.join("agent/temporary-media");
+        private_dir(&directory)?;
+        Ok(directory.join(id))
+    }
+
+    pub(crate) fn write_temporary_media(
+        &self,
+        account: &str,
+        id: &str,
+        bytes: &[u8],
+    ) -> Result<()> {
+        let path = self.temporary_media_path(account, id)?;
+        let mut file = wechat_platform::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(wechat_platform::NOFOLLOW)
+            .open(&path)?;
+        if let Err(error) = file.write_all(bytes).and_then(|()| file.sync_all()) {
+            drop(file);
+            let _ = fs::remove_file(path);
+            return Err(error.into());
+        }
+        Ok(())
+    }
+
+    pub(crate) fn read_temporary_media(&self, account: &str, id: &str) -> Result<Vec<u8>> {
+        let path = self.temporary_media_path(account, id)?;
+        let file = wechat_platform::OpenOptions::new()
+            .read(true)
+            .custom_flags(wechat_platform::NOFOLLOW)
+            .open(path)
+            .context("media_source_released")?;
+        let metadata = file.metadata()?;
+        let limit = wechat_media::MAX_MEDIA_SOURCE_BYTES.saturating_add(4096);
+        if !metadata.is_file() || metadata.len() > limit as u64 {
+            bail!("invalid temporary media file");
+        }
+        let mut bytes = Vec::new();
+        file.take(limit as u64 + 1).read_to_end(&mut bytes)?;
+        if bytes.len() > limit {
+            bail!("invalid temporary media file");
+        }
+        Ok(bytes)
+    }
+
+    pub(crate) fn remove_temporary_media(&self, account: &str, id: &str) -> Result<()> {
+        fs::remove_file(self.temporary_media_path(account, id)?)?;
+        Ok(())
+    }
+
+    /// Release staging only after all referring jobs are settled. Metadata remains
+    /// available for idempotency; uncertain/retryable jobs retain their bytes.
+    pub fn cleanup_temporary_media(
+        &self,
+        account: &str,
+        completed_before: &str,
+        orphan_before: &str,
+    ) -> Result<usize> {
+        self.control(account, |db| {
+            let mut query = db.prepare(
+                "SELECT s.id FROM media_sources s
+                 WHERE s.id GLOB 'upload_tmp_*' AND s.payload=?1
+                 AND NOT EXISTS (
+                   SELECT 1 FROM media_jobs j
+                   WHERE (json_extract(j.data_json,'$.sourceId')=s.id OR EXISTS (
+                     SELECT 1 FROM json_each(j.data_json,'$.sourceIds') r WHERE r.value=s.id))
+                   AND NOT coalesce((
+                     julianday(j.updated_at)<=julianday(?2) AND (
+                       (j.state='accepted'
+                        AND json_extract(j.data_json,'$.result.profileProjection')='complete'
+                        AND json_extract(j.data_json,'$.result.officialMediaWriteback')='complete')
+                       OR (j.state IN ('failed','cancelled') AND j.retryable=0
+                           AND json_extract(j.data_json,'$.serverMessageId') IS NULL
+                           AND json_extract(j.data_json,'$.result.nativeReceipt') IS NULL
+                           AND coalesce(json_array_length(j.data_json,'$.result.messageIds'),0)=0))
+                   ),0)
+                 )
+                 AND (julianday(s.created_at)<=julianday(?3) OR EXISTS (
+                   SELECT 1 FROM media_jobs j
+                   WHERE json_extract(j.data_json,'$.sourceId')=s.id OR EXISTS (
+                     SELECT 1 FROM json_each(j.data_json,'$.sourceIds') r WHERE r.value=s.id)))
+                 ORDER BY s.created_at,s.id LIMIT 100",
+            )?;
+            let ids = query
+                .query_map(
+                    params![TEMPORARY_MEDIA_MARKER, completed_before, orphan_before],
+                    |r| r.get::<_, String>(0),
+                )?
+                .collect::<rusqlite::Result<Vec<_>>>()?;
+            drop(query);
+            let mut released = 0;
+            for id in ids {
+                let path = self.temporary_media_path(account, &id)?;
+                match fs::remove_file(path) {
+                    Ok(()) => {}
+                    Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+                    Err(_) => continue,
+                }
+                released += db.execute(
+                    "UPDATE media_sources SET payload=X'' WHERE id=?1 AND payload=?2",
+                    params![id, TEMPORARY_MEDIA_MARKER],
+                )?;
+            }
+            // A crash between file creation and the SQLite insert can leave an
+            // unreferenced file. Only our validated namespace is eligible.
+            let directory = self.account_dir(account)?.join("agent/temporary-media");
+            let cutoff = chrono::DateTime::parse_from_rfc3339(orphan_before)?;
+            if let Ok(entries) = fs::read_dir(directory) {
+                for entry in entries.take(1000) {
+                    let entry = entry?;
+                    let Some(id) = entry.file_name().to_str().map(str::to_owned) else {
+                        continue;
+                    };
+                    if !is_temporary_media_source(&id)
+                        || self.temporary_media_path(account, &id).is_err()
+                    {
+                        continue;
+                    }
+                    let metadata = fs::symlink_metadata(entry.path())?;
+                    if !metadata.is_file() || wechat_platform::is_link(&metadata) {
+                        continue;
+                    }
+                    let modified: chrono::DateTime<chrono::Utc> = metadata.modified()?.into();
+                    if modified >= cutoff {
+                        continue;
+                    }
+                    let exists: bool = db.query_row(
+                        "SELECT EXISTS(SELECT 1 FROM media_sources WHERE id=?1)",
+                        [&id],
+                        |r| r.get(0),
+                    )?;
+                    if !exists && fs::remove_file(entry.path()).is_ok() {
+                        released += 1;
+                    }
+                }
+            }
+            Ok(released)
+        })
+    }
+}
