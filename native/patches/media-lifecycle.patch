+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    const BEFORE: &str = "2000-01-01T00:00:00+00:00";
+    const AFTER: &str = "2099-01-01T00:00:00+00:00";
+
+    fn setup() -> (tempfile::TempDir, Store) {
+        let directory = tempfile::tempdir().unwrap();
+        let store = Store::open(&directory.path().join("data")).unwrap();
+        store.create_account("one").unwrap();
+        store.create_account("two").unwrap();
+        (directory, store)
+    }
+
+    fn source(store: &Store, account: &str, id: &str) {
+        store
+            .create_media_source(
+                account,
+                id,
+                "video.mp4",
+                "video/mp4",
+                100,
+                &"a".repeat(64),
+                b"opaque-encrypted-video",
+            )
+            .unwrap();
+    }
+
+    fn job(
+        store: &Store,
+        id: &str,
+        source: &str,
+        state: &str,
+        retryable: bool,
+        result: serde_json::Value,
+    ) {
+        store
+            .create_media_job(
+                "one",
+                id,
+                &format!("send:{id}"),
+                &"a".repeat(64),
+                "send",
+                &json!({"sourceId":"another-primary", "sourceIds":[source], "result":result}),
+                b"plan",
+            )
+            .unwrap();
+        store
+            .control("one", |db| {
+                db.execute(
+                    "UPDATE media_jobs SET state=?2,retryable=?3 WHERE id=?1",
+                    params![id, state, retryable],
+                )?;
+                Ok(())
+            })
+            .unwrap();
+    }
+
+    #[test]
+    fn temporary_sources_are_file_backed_and_survive_restart() {
+        let (directory, store) = setup();
+        source(&store, "one", "upload_tmp_test");
+        let path = store
+            .temporary_media_path("one", "upload_tmp_test")
+            .unwrap();
+        assert_eq!(fs::read(&path).unwrap(), b"opaque-encrypted-video");
+        store
+            .control("one", |db| {
+                let payload: Vec<u8> = db.query_row(
+                    "SELECT payload FROM media_sources WHERE id='upload_tmp_test'",
+                    [],
+                    |r| r.get(0),
+                )?;
+                assert_eq!(payload, TEMPORARY_MEDIA_MARKER);
+                Ok(())
+            })
+            .unwrap();
+        assert!(store.media_source("two", "upload_tmp_test").is_err());
+        drop(store);
+        let store = Store::open(&directory.path().join("data")).unwrap();
+        assert_eq!(
+            store.media_source("one", "upload_tmp_test").unwrap().1,
+            b"opaque-encrypted-video"
+        );
+        assert_eq!(
+            store.cleanup_temporary_media("one", AFTER, BEFORE).unwrap(),
+            0
+        );
+        assert_eq!(
+            store.cleanup_temporary_media("one", AFTER, AFTER).unwrap(),
+            1
+        );
+        assert!(!path.exists());
+        assert!(store
+            .media_source("one", "upload_tmp_test")
+            .unwrap_err()
+            .to_string()
+            .contains("media_source_released"));
+        assert_eq!(
+            store
+                .media_source_metadata("one", "upload_tmp_test")
+                .unwrap()
+                .byte_length,
+            100
+        );
+        assert_eq!(
+            store.cleanup_temporary_media("one", AFTER, AFTER).unwrap(),
+            0
+        );
+    }
+
+    #[test]
+    fn cleanup_requires_confirmed_complete_writeback_and_grace_period() {
+        for (state, retryable, result, releasable) in [
+            ("queued", false, json!({}), false),
+            ("running", false, json!({}), false),
+            ("needs_review", false, json!({}), false),
+            ("partial", false, json!({}), false),
+            ("accepted", false, json!({}), false),
+            (
+                "accepted",
+                false,
+                json!({"profileProjection":"complete"}),
+                false,
+            ),
+            (
+                "accepted",
+                false,
+                json!({"profileProjection":"complete","officialMediaWriteback":"blocked"}),
+                false,
+            ),
+            (
+                "accepted",
+                false,
+                json!({"profileProjection":"complete","officialMediaWriteback":"complete"}),
+                true,
+            ),
+            ("failed", true, json!({}), false),
+            ("failed", false, json!({}), true),
+            ("cancelled", false, json!({}), true),
+        ] {
+            let (_directory, store) = setup();
+            source(&store, "one", "upload_tmp_job");
+            job(&store, "job", "upload_tmp_job", state, retryable, result);
+            assert_eq!(
+                store.cleanup_temporary_media("one", BEFORE, AFTER).unwrap(),
+                0,
+                "{state}"
+            );
+            assert_eq!(
+                store.cleanup_temporary_media("one", AFTER, AFTER).unwrap(),
+                usize::from(releasable),
+                "{state}"
+            );
+        }
+    }
+
+    #[test]
+    fn shared_active_sources_durable_uploads_and_user_files_are_preserved() {
+        let (directory, store) = setup();
+        source(&store, "one", "upload_tmp_shared");
+        source(&store, "one", "upload_durable");
+        source(&store, "two", "upload_tmp_shared");
+        let original = directory.path().join("original.mp4");
+        fs::write(&original, b"user-owned-video").unwrap();
+        let complete = json!({"profileProjection":"complete","officialMediaWriteback":"complete"});
+        job(
+            &store,
+            "done",
+            "upload_tmp_shared",
+            "accepted",
+            false,
+            complete.clone(),
+        );
+        job(
+            &store,
+            "active",
+            "upload_tmp_shared",
+            "running",
+            false,
+            json!({}),
+        );
+        assert_eq!(
+            store.cleanup_temporary_media("one", AFTER, AFTER).unwrap(),
+            0
+        );
+        store.control("one", |db| {
+            db.execute("UPDATE media_jobs SET state='accepted',data_json=json_set(data_json,'$.result',json(?1)) WHERE id='active'", [complete.to_string()])?;
+            Ok(())
+        }).unwrap();
+        assert_eq!(
+            store.cleanup_temporary_media("one", AFTER, AFTER).unwrap(),
+            1
+        );
+        assert!(store.media_source("one", "upload_durable").is_ok());
+        assert!(store.media_source("two", "upload_tmp_shared").is_ok());
+        assert_eq!(fs::read(original).unwrap(), b"user-owned-video");
+        assert!(store
+            .create_media_source(
+                "one",
+                "upload_tmp_../../original.mp4",
+                "bad",
+                "video/mp4",
+                1,
+                &"a".repeat(64),
+                b"bad"
+            )
+            .is_err());
+    }
+}
