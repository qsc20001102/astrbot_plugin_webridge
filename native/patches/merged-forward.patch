diff --git a/packages/native-client-rust/crates/wechat-core/src/forward_send.rs b/packages/native-client-rust/crates/wechat-core/src/forward_send.rs
new file mode 100644
index 0000000..91e53a3
--- /dev/null
+++ b/packages/native-client-rust/crates/wechat-core/src/forward_send.rs
@@ -0,0 +1,186 @@
+//! Combine-and-forward cards use the existing durable app-message send queue.
+use anyhow::{ensure, Result};
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+
+#[derive(Clone, Debug, Serialize, Deserialize, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ForwardNode {
+    pub name: String,
+    pub uin: String,
+    pub time: u32,
+    pub content: Vec<ForwardPart>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, TS)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ForwardPart {
+    Text { text: String },
+    Image {
+        #[serde(rename = "sourceId")]
+        source_id: String,
+    },
+    Forward { nodes: Vec<ForwardNode> },
+}
+
+fn tag(name: &str, value: &str) -> String {
+    let escaped = value.replace('&', "&amp;").replace('<', "&lt;")
+        .replace('>', "&gt;").replace('"', "&quot;").replace('\'', "&apos;");
+    format!("<{name}>{escaped}</{name}>")
+}
+
+fn valid(value: &str, max: usize) -> bool {
+    value.len() <= max && value.chars().all(|c| {
+        (!c.is_control() || matches!(c, '\n' | '\t' | '\r'))
+            && !matches!(c, '\u{fffe}' | '\u{ffff}')
+    })
+}
+
+pub(crate) fn validate(nodes: &[ForwardNode]) -> Result<()> {
+    fn walk(nodes: &[ForwardNode], depth: usize, count: &mut usize, bytes: &mut usize) -> Result<()> {
+        ensure!(!nodes.is_empty() && depth <= 8, "invalid_forward_nodes");
+        for node in nodes {
+            *count += 1;
+            *bytes += node.name.len() + node.uin.len();
+            ensure!(*count <= 500 && valid(&node.name, 1024) && valid(&node.uin, 256)
+                && !node.content.is_empty(), "invalid_forward_node");
+            for part in &node.content {
+                *count += 1;
+                ensure!(*count <= 1024, "invalid_forward_nodes");
+                match part {
+                    ForwardPart::Text { text } => {
+                        ensure!(valid(text, 64 * 1024), "invalid_forward_text");
+                        *bytes += text.len();
+                    }
+                    ForwardPart::Image { source_id } => {
+                        ensure!(!source_id.is_empty() && valid(source_id, 256), "invalid_forward_image");
+                    }
+                    ForwardPart::Forward { nodes } => walk(nodes, depth + 1, count, bytes)?,
+                }
+                ensure!(*bytes <= 128 * 1024, "forward_size_limit");
+            }
+        }
+        Ok(())
+    }
+    walk(nodes, 0, &mut 0, &mut 0)
+}
+
+fn record(
+    nodes: &[ForwardNode],
+    image: &mut dyn FnMut(&str) -> Result<String>,
+) -> Result<String> {
+    let mut items = Vec::new();
+    for node in nodes {
+        for part in &node.content {
+            let (datatype, body) = match part {
+                ForwardPart::Text { text } => (1, tag("datadesc", text)),
+                ForwardPart::Image { source_id } => (2, image(source_id)?),
+                ForwardPart::Forward { nodes } => (17, format!("{}{}",
+                    tag("datatitle", "聊天记录"), tag("recordxml", &record(nodes, image)?))),
+            };
+            let data_id = uuid::Uuid::new_v4().simple().to_string();
+            let name = tag("sourcename", &node.name);
+            let sender = tag("realchatname", &node.uin);
+            let time = chrono::DateTime::from_timestamp(i64::from(node.time), 0)
+                .map(|stamp| stamp.format("%Y-%m-%d %H:%M:%S").to_string()).unwrap_or_default();
+            items.push(format!("<dataitem datatype=\"{datatype}\" dataid=\"{data_id}\">{body}{name}{}{}<dataitemsource>{name}{sender}</dataitemsource></dataitem>",
+                tag("sourcetime", &time), tag("srcMsgCreateTime", &node.time.to_string())));
+        }
+    }
+    Ok(format!("<recordinfo>{}<datalist count=\"{}\">{}</datalist></recordinfo>",
+        tag("title", "聊天记录"), items.len(), items.join("")))
+}
+
+pub(crate) fn xml(
+    sender: &str,
+    nodes: &[ForwardNode],
+    image: &mut dyn FnMut(&str) -> Result<String>,
+) -> Result<String> {
+    validate(nodes)?;
+    let record = record(nodes, image)?;
+    let xml = format!("<appmsg appid=\"\" sdkver=\"0\">{}{}<type>19</type><showtype>0</showtype>{}<appattach/></appmsg>{}",
+        tag("title", "聊天记录"), tag("des", &format!("{} 条聊天记录", nodes.len())),
+        tag("recorditem", &record), tag("fromusername", sender));
+    ensure!(xml.len() <= 256 * 1024, "forward_size_limit");
+    Ok(xml)
+}
+
+impl crate::Core {
+    pub(crate) fn forward_image_xml(
+        &self,
+        account: &str,
+        thread: &str,
+        source_id: &str,
+        state: &mut wechat_protocol::AccountState,
+    ) -> Result<String> {
+        let (source, bytes) = self.source_bytes(account, source_id)?;
+        let (original, standard, thumbnail) = crate::media::image_variants(
+            &bytes, None, None, crate::media::ImageVariantSizing::PreserveOriginal,
+        )?;
+        let material = uuid::Uuid::new_v4();
+        let prepared = wechat_protocol::media::PreparedImageUpload::with_material(
+            &original, &standard, &thumbnail, &source.name, thread, material.as_bytes(),
+            &uuid::Uuid::new_v4().simple().to_string(),
+        )?;
+        let transport = self.upstream.media_transport_route(state, None)?;
+        let image = transport.upload_image(&prepared, &|_, _| {
+            ensure!(!self.stopping.load(std::sync::atomic::Ordering::SeqCst)
+                && self.store.runtime(account, "desired")?.as_deref() == Some(b"connected"),
+                "forward_cancelled");
+            Ok(())
+        })?;
+        let mut xml = tag("datadesc", "[图片]");
+        for (prefix, uploaded) in [("data", &image.original), ("thumb", &image.thumbnail)] {
+            let key: String = uploaded.descriptor.aes_key.iter().map(|v| format!("{v:02x}")).collect();
+            xml.push_str(&tag(&format!("cdn_{prefix}url"), &uploaded.descriptor.file_id));
+            xml.push_str(&tag(&format!("cdn_{prefix}key"), &key));
+        }
+        for (name, value) in [
+            ("fullmd5", image.original.md5.clone()),
+            ("fullsize", image.original.plaintext_bytes.to_string()),
+            ("thumbfullmd5", image.thumbnail.md5.clone()),
+            ("thumbfullsize", image.thumbnail.plaintext_bytes.to_string()),
+        ] { xml.push_str(&tag(name, &value)); }
+        Ok(xml)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn node(text: &str) -> ForwardNode {
+        ForwardNode { name: "Alice & Bob".into(), uin: "author".into(), time: 123,
+            content: vec![ForwardPart::Text { text: text.into() }] }
+    }
+    #[test]
+    fn card_preserves_names_text_time_and_nested_record_structure() {
+        let mut outer = node("<hello> & world");
+        outer.content.push(ForwardPart::Forward { nodes: vec![node("nested")] });
+        let xml = xml("self", &[outer], &mut |_| unreachable!()).unwrap();
+        let wrapped = format!("<msg>{xml}</msg>");
+        let doc = roxmltree::Document::parse(&wrapped).unwrap();
+        let record = doc.descendants().find(|n| n.has_tag_name("recorditem")).unwrap().text().unwrap();
+        let record = roxmltree::Document::parse(record).unwrap();
+        assert_eq!(record.descendants().find(|n| n.has_tag_name("datadesc")).unwrap().text(), Some("<hello> & world"));
+        assert!(record.descendants().any(|n| n.has_tag_name("srcMsgCreateTime") && n.text() == Some("123")));
+        assert!(record.descendants().any(|n| n.has_tag_name("recordxml")));
+    }
+    #[test]
+    fn image_nodes_use_an_uploaded_descriptor_inside_the_card() {
+        let mut item = node("caption");
+        item.content.push(ForwardPart::Image { source_id: "source".into() });
+        let mut seen = Vec::new();
+        let result = xml("self", &[item], &mut |source| {
+            seen.push(source.to_owned());
+            Ok(tag("cdn_dataurl", "uploaded-file"))
+        }).unwrap();
+        assert_eq!(seen, ["source"]);
+        assert!(result.contains("uploaded-file"));
+    }
+    #[test]
+    fn rejects_empty_oversized_and_control_character_nodes() {
+        assert!(validate(&[]).is_err());
+        assert!(validate(&[node("bad\0text")]).is_err());
+        assert!(validate(&[node(&"x".repeat(64 * 1024 + 1))]).is_err());
+    }
+}
