diff --git a/packages/native-client-rust/crates/wechat-core/src/forward_send.rs b/packages/native-client-rust/crates/wechat-core/src/forward_send.rs
new file mode 100644
index 0000000..aeece92
--- /dev/null
+++ b/packages/native-client-rust/crates/wechat-core/src/forward_send.rs
@@ -0,0 +1,285 @@
+//! Combine-and-forward cards use the existing durable app-message send queue.
+use anyhow::{ensure, Result};
+use serde::{Deserialize, Serialize};
+use ts_rs::TS;
+use wechat_protocol::media::{MediaQuality, PreparedUpload, UploadedMedia};
+
+#[derive(Clone, Debug, Serialize, Deserialize, TS)]
+#[serde(rename_all = "camelCase", deny_unknown_fields)]
+pub struct ForwardNode {
+    pub name: String,
+    pub uin: String,
+    pub time: u32,
+    pub content: Vec<ForwardPart>,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize, TS)]
+#[serde(tag = "type", rename_all = "snake_case", deny_unknown_fields)]
+pub enum ForwardPart {
+    Text { text: String },
+    Image {
+        #[serde(rename = "sourceId")]
+        source_id: String,
+    },
+    Forward { nodes: Vec<ForwardNode> },
+}
+
+fn tag(name: &str, value: &str) -> String {
+    let escaped = value.replace('&', "&amp;").replace('<', "&lt;")
+        .replace('>', "&gt;").replace('"', "&quot;").replace('\'', "&apos;");
+    format!("<{name}>{escaped}</{name}>")
+}
+
+fn valid(value: &str, max: usize) -> bool {
+    value.len() <= max && value.chars().all(|c| {
+        (!c.is_control() || matches!(c, '\n' | '\t' | '\r'))
+            && !matches!(c, '\u{fffe}' | '\u{ffff}')
+    })
+}
+
+pub(crate) fn validate(nodes: &[ForwardNode]) -> Result<()> {
+    fn walk(nodes: &[ForwardNode], depth: usize, count: &mut usize, bytes: &mut usize) -> Result<()> {
+        ensure!(!nodes.is_empty() && depth <= 8, "invalid_forward_nodes");
+        for node in nodes {
+            *count += 1;
+            *bytes += node.name.len() + node.uin.len();
+            ensure!(*count <= 500 && valid(&node.name, 1024) && valid(&node.uin, 256)
+                && !node.content.is_empty(), "invalid_forward_node");
+            for part in &node.content {
+                *count += 1;
+                ensure!(*count <= 1024, "invalid_forward_nodes");
+                match part {
+                    ForwardPart::Text { text } => {
+                        ensure!(valid(text, 64 * 1024), "invalid_forward_text");
+                        *bytes += text.len();
+                    }
+                    ForwardPart::Image { source_id } => {
+                        ensure!(!source_id.is_empty() && valid(source_id, 256), "invalid_forward_image");
+                    }
+                    ForwardPart::Forward { nodes } => walk(nodes, depth + 1, count, bytes)?,
+                }
+                ensure!(*bytes <= 128 * 1024, "forward_size_limit");
+            }
+        }
+        Ok(())
+    }
+    walk(nodes, 0, &mut 0, &mut 0)
+}
+
+fn record(
+    nodes: &[ForwardNode],
+    image: &mut dyn FnMut(&str) -> Result<String>,
+) -> Result<String> {
+    let mut items = Vec::new();
+    for node in nodes {
+        for part in &node.content {
+            let (datatype, body) = match part {
+                ForwardPart::Text { text } => (1, tag("datadesc", text)),
+                ForwardPart::Image { source_id } => (2, image(source_id)?),
+                ForwardPart::Forward { nodes } => (17, format!("{}{}",
+                    tag("datatitle", "聊天记录"), tag("recordxml", &record(nodes, image)?))),
+            };
+            let data_id = uuid::Uuid::new_v4().simple().to_string();
+            let name = tag("sourcename", &node.name);
+            let sender = tag("realchatname", &node.uin);
+            let time = chrono::DateTime::from_timestamp(i64::from(node.time), 0)
+                .map(|stamp| stamp.format("%Y-%m-%d %H:%M:%S").to_string()).unwrap_or_default();
+            items.push(format!("<dataitem datatype=\"{datatype}\" dataid=\"{data_id}\">{body}{name}{}{}<dataitemsource>{name}{sender}</dataitemsource></dataitem>",
+                tag("sourcetime", &time), tag("srcMsgCreateTime", &node.time.to_string())));
+        }
+    }
+    Ok(format!("<recordinfo>{}<datalist count=\"{}\">{}</datalist></recordinfo>",
+        tag("title", "聊天记录"), items.len(), items.join("")))
+}
+
+pub(crate) fn xml(
+    sender: &str,
+    nodes: &[ForwardNode],
+    image: &mut dyn FnMut(&str) -> Result<String>,
+) -> Result<String> {
+    validate(nodes)?;
+    let record = record(nodes, image)?;
+    let xml = format!("<appmsg appid=\"\" sdkver=\"0\">{}{}<type>19</type><showtype>0</showtype>{}<appattach/></appmsg>{}",
+        tag("title", "聊天记录"), tag("des", &format!("{} 条聊天记录", nodes.len())),
+        tag("recorditem", &record), tag("fromusername", sender));
+    ensure!(xml.len() <= 256 * 1024, "forward_size_limit");
+    Ok(xml)
+}
+
+fn hex(bytes: &[u8]) -> String {
+    bytes.iter().map(|value| format!("{value:02x}")).collect()
+}
+
+fn record_image_xml(
+    original: &[u8],
+    thumbnail: &[u8],
+    thread: &str,
+    upload: &mut dyn FnMut(&PreparedUpload) -> Result<UploadedMedia>,
+) -> Result<String> {
+    let thumb_info = wechat_media::inspect_image(thumbnail)?;
+    // RecordMsgCDNService reads BOTH objects as FULLSIZEIMAGE (filetype 1).
+    // A chat-image upload shares one file ID across qualities 1/2/3, so its
+    // type-3 thumbnail cannot be placed in a record's type-1 thumbnail slot.
+    let original_upload = PreparedUpload::prepare(
+        original, MediaQuality::Original, "image.jpg", thread,
+    )?;
+    let thumbnail_upload = PreparedUpload::prepare(
+        thumbnail, MediaQuality::Original, "thumb.jpg", thread,
+    )?;
+    let image = upload(&original_upload)?;
+    let thumb = upload(&thumbnail_upload)?;
+    let mut xml = tag("datadesc", "[图片]");
+    // Record messages use these names; favorite XML's cdn_dataurl/fullsize
+    // spellings are not recognized by the record-message parser.
+    for (name, value) in [
+        ("datafmt", "jpg".to_owned()),
+        ("dataext", "jpg".to_owned()),
+        ("cdndataurl", image.descriptor.file_id.clone()),
+        ("cdndatakey", hex(&image.descriptor.aes_key)),
+        ("cdnthumburl", thumb.descriptor.file_id.clone()),
+        ("cdnthumbkey", hex(&thumb.descriptor.aes_key)),
+        ("fullmd5", image.md5.clone()),
+        ("head256md5", hex(&wechat_protocol::crypto::md5(&original[..original.len().min(256)]))),
+        ("datasize", image.plaintext_bytes.to_string()),
+        ("thumbfullmd5", thumb.md5.clone()),
+        ("thumbhead256md5", hex(&wechat_protocol::crypto::md5(&thumbnail[..thumbnail.len().min(256)]))),
+        ("thumbsize", thumb.plaintext_bytes.to_string()),
+        ("thumbwidth", thumb_info.width.to_string()),
+        ("thumbheight", thumb_info.height.to_string()),
+    ] {
+        xml.push_str(&tag(name, &value));
+    }
+    Ok(xml)
+}
+
+impl crate::Core {
+    pub(crate) fn forward_image_xml(
+        &self,
+        account: &str,
+        thread: &str,
+        source_id: &str,
+        state: &mut wechat_protocol::AccountState,
+    ) -> Result<String> {
+        let (_, bytes) = self.source_bytes(account, source_id)?;
+        let (original, _, thumbnail) = crate::media::image_variants(
+            &bytes, None, None, crate::media::ImageVariantSizing::PreserveOriginal,
+        )?;
+        let transport = self.upstream.media_transport_route(state, None)?;
+        let progress = |_, _| {
+            ensure!(!self.stopping.load(std::sync::atomic::Ordering::SeqCst)
+                && self.store.runtime(account, "desired")?.as_deref() == Some(b"connected"),
+                "forward_cancelled");
+            Ok(())
+        };
+        record_image_xml(&original, &thumbnail, thread, &mut |prepared| {
+            transport.upload(prepared, &progress)
+        })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn node(text: &str) -> ForwardNode {
+        ForwardNode { name: "Alice & Bob".into(), uin: "author".into(), time: 123,
+            content: vec![ForwardPart::Text { text: text.into() }] }
+    }
+    #[test]
+    fn card_preserves_names_text_time_and_nested_record_structure() {
+        let mut outer = node("<hello> & world");
+        outer.content.push(ForwardPart::Forward { nodes: vec![node("nested")] });
+        let xml = xml("self", &[outer], &mut |_| unreachable!()).unwrap();
+        let wrapped = format!("<msg>{xml}</msg>");
+        let doc = roxmltree::Document::parse(&wrapped).unwrap();
+        let record = doc.descendants().find(|n| n.has_tag_name("recorditem")).unwrap().text().unwrap();
+        let record = roxmltree::Document::parse(record).unwrap();
+        assert_eq!(record.descendants().find(|n| n.has_tag_name("datadesc")).unwrap().text(), Some("<hello> & world"));
+        assert!(record.descendants().any(|n| n.has_tag_name("srcMsgCreateTime") && n.text() == Some("123")));
+        assert!(record.descendants().any(|n| n.has_tag_name("recordxml")));
+    }
+    #[test]
+    fn record_images_and_thumbnails_are_independently_readable_as_fullsize_images() {
+        use wechat_protocol::media::MediaDescriptor;
+        let mut source = Vec::new();
+        image::codecs::jpeg::JpegEncoder::new_with_quality(&mut source, 95)
+            .encode_image(&image::DynamicImage::new_rgb8(320, 240)).unwrap();
+        let (original, _, thumbnail) = crate::media::image_variants(
+            &source, None, None, crate::media::ImageVariantSizing::PreserveOriginal,
+        ).unwrap();
+        assert_eq!(source, original);
+        assert_ne!(original, thumbnail);
+        let mut item = node("caption");
+        item.content.push(ForwardPart::Image { source_id: "source".into() });
+        let mut uploads = Vec::new();
+        let result = xml("self", &[item], &mut |source| {
+            assert_eq!(source, "source");
+            record_image_xml(&original, &thumbnail, "recipient", &mut |prepared| {
+                assert_eq!(prepared.kind.filetype(), 1);
+                assert_eq!(prepared.destination, "recipient");
+                uploads.push(prepared.clone());
+                Ok(UploadedMedia {
+                    descriptor: MediaDescriptor {
+                        file_id: format!("uploaded-{}", uploads.len()),
+                        aes_key: prepared.aes_key.clone(),
+                        quality: prepared.kind,
+                        expected_bytes: Some(u64::from(prepared.plaintext_bytes)),
+                        expected_md5: Some(prepared.md5.clone()), strict_size: true,
+                        expires_at: None,
+                    },
+                    plaintext_bytes: prepared.plaintext_bytes,
+                    md5: prepared.md5.clone(), sha256: prepared.sha256.clone(),
+                    file_name: prepared.file_name.clone(), width: None, height: None,
+                })
+            })
+        }).unwrap();
+        assert_eq!(uploads.len(), 2);
+        assert_ne!(uploads[0].file_key, uploads[1].file_key);
+        assert_ne!(uploads[0].aes_key, uploads[1].aes_key);
+        let wrapped = format!("<msg>{result}</msg>");
+        let outer = roxmltree::Document::parse(&wrapped).unwrap();
+        let record = outer.descendants().find(|n| n.has_tag_name("recorditem")).unwrap().text().unwrap();
+        let record = roxmltree::Document::parse(record).unwrap();
+        let item = record.descendants().find(|n| n.attribute("datatype") == Some("2")).unwrap();
+        let value = |name: &str| item.children().find(|n| n.has_tag_name(name)).unwrap().text().unwrap().to_owned();
+        // Emulate the record reader: exact record field names, filetype 1 for
+        // both objects, then decryption, declared size and digest validation.
+        for (index, prefix, size, digest, head, expected) in [
+            (0, "data", "datasize", "fullmd5", "head256md5", &original),
+            (1, "thumb", "thumbsize", "thumbfullmd5", "thumbhead256md5", &thumbnail),
+        ] {
+            assert_eq!(value(&format!("cdn{prefix}url")), format!("uploaded-{}", index + 1));
+            let encoded_key = value(&format!("cdn{prefix}key"));
+            let key: Vec<u8> = (0..encoded_key.len()).step_by(2)
+                .map(|i| u8::from_str_radix(&encoded_key[i..i + 2], 16).unwrap()).collect();
+            let raw = openssl::symm::decrypt(openssl::symm::Cipher::aes_128_ecb(),
+                &key, None, &uploads[index].encrypted).unwrap();
+            assert_eq!(&raw, expected);
+            assert_eq!(value(size).parse::<usize>().unwrap(), raw.len());
+            assert_eq!(value(digest), hex(&wechat_protocol::crypto::md5(&raw)));
+            assert_eq!(value(head), hex(&wechat_protocol::crypto::md5(&raw[..256])));
+        }
+        assert_eq!(value("thumbwidth"), "160");
+        assert_eq!(value("thumbheight"), "120");
+        assert!(!record.descendants().any(|n| n.has_tag_name("cdn_dataurl")
+            || n.has_tag_name("fullsize") || n.has_tag_name("thumbfullsize")));
+    }
+    #[test]
+    fn failed_record_image_upload_aborts_card_preparation() {
+        let mut thumbnail = Vec::new();
+        image::codecs::jpeg::JpegEncoder::new(&mut thumbnail)
+            .encode_image(&image::DynamicImage::new_rgb8(2, 2)).unwrap();
+        let mut calls = 0;
+        let error = record_image_xml(&thumbnail, &thumbnail, "recipient", &mut |_| {
+            calls += 1;
+            anyhow::bail!("synthetic_upload_rejected")
+        }).unwrap_err();
+        assert_eq!(calls, 1);
+        assert_eq!(error.to_string(), "synthetic_upload_rejected");
+    }
+    #[test]
+    fn rejects_empty_oversized_and_control_character_nodes() {
+        assert!(validate(&[]).is_err());
+        assert!(validate(&[node("bad\0text")]).is_err());
+        assert!(validate(&[node(&"x".repeat(64 * 1024 + 1))]).is_err());
+    }
+}
